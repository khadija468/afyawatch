APP_NAME=AfyaWatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite needs no server. On a VM you can switch to MySQL:
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=afyawatch
# DB_USERNAME=afyawatch
# DB_PASSWORD=

# Short sessions that end when the browser closes: health workers often share devices.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Set to true in production (cookies only sent over HTTPS)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# "log" writes emails to storage/logs/laravel.log. Use smtp in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@afyawatch.test"
MAIL_FROM_NAME="${APP_NAME} alerts"

# Production security
FORCE_HTTPS=false
TRUSTED_PROXIES=127.0.0.1

# AfyaWatch
AFYAWATCH_SYNTHETIC_DATA=true
AFYAWATCH_SHOW_DEMO_ACCOUNTS=true
AFYAWATCH_DEFAULT_CONDITION=B05
# Password for the seeded demo accounts (required when APP_ENV=production)
DEMO_USER_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
